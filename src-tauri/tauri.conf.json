{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "ElshrqawySystem",
    "version": "9.1.3"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true },
      "dialog": { "all": true },
      "window": { "all": true },
      "process": { "relaunch": true }
    },
    "bundle": {
      "active": true,
      "identifier": "com.elshrqawy.system",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/fatmayaseen6322-hue/elshrqawy-system-v5/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxREY4RDExM0JCRDU5RDYKUldUV1diMDdFWTNmSVh2RFlkckxrK2lZMFpseUVNSVJWOWo1Z3h2ZUo2bnZtWVk4di9BTCticXcK"
    },
    "windows": [
      {
        "title": "مركز الشرقاوي التعليمي",
        "width": 900,
        "height": 700,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ]
  }
}
